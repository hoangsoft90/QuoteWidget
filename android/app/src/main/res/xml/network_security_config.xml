<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain-http traffic for any domain. This is the robust Android way
     to permit cleartext everywhere: unlike the app-level
     android:usesCleartextTraffic attribute, a network security config is not
     overridden by library manifests merged into the release APK. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>